{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tensor Core Arithmetic GEMM request",
  "description": "One object per JSONL line. Matrices use flat row-major unsigned encoded words. Lengths must equal m*k, k*n, and m*n; the executable checks these dependent dimensions. Scaled operations convert A and B to FP16 before tensor-core execution. FP64 words require an integer-preserving JSON parser. Extra fields are ignored. Family analysis uses uniform rational magnitude caps instead of encoded arrays and quantifies over all finite matrices of the declared shapes. Native operations multiply BF16 or packed TF32 inputs directly. Entry families use one nonnegative rational magnitude cap per entry.",
  "type": "object",
  "required": [
    "operation",
    "model",
    "m",
    "n",
    "k"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Optional case label; results retain input order."
    },
    "operation": {
      "enum": [
        "raw",
        "certify",
        "scaled",
        "certify_scaled",
        "analyze",
        "analyze_scaled",
        "analyze_family",
        "native",
        "analyze_native",
        "analyze_entry_family"
      ]
    },
    "model": {
      "enum": [
        "v100",
        "ampere",
        "hopper",
        "hopper_mma"
      ]
    },
    "m": {
      "type": "integer",
      "minimum": 0
    },
    "n": {
      "type": "integer",
      "minimum": 0
    },
    "k": {
      "type": "integer",
      "minimum": 0
    },
    "a": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      }
    },
    "b": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      }
    },
    "c": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "input_format": {
      "enum": [
        "fp16",
        "bf16",
        "fp32",
        "fp64"
      ]
    },
    "output_format": {
      "enum": [
        "fp16",
        "bf16",
        "fp32",
        "fp64"
      ]
    },
    "alpha": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "beta": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "input_mode": {
      "enum": [
        "rne",
        "rtz",
        "rdn",
        "rup"
      ]
    },
    "multiply_mode": {
      "enum": [
        "rne",
        "rtz",
        "rdn",
        "rup"
      ]
    },
    "add_mode": {
      "enum": [
        "rne",
        "rtz",
        "rdn",
        "rup"
      ]
    },
    "output_mode": {
      "enum": [
        "rne",
        "rtz",
        "rdn",
        "rup"
      ]
    },
    "accumulator_scale": {
      "type": "integer"
    },
    "product_scale": {
      "type": "integer"
    },
    "initial_bound": {
      "type": "integer"
    },
    "alpha_scale": {
      "type": "integer"
    },
    "beta_scale": {
      "type": "integer"
    },
    "sum_scale": {
      "type": "integer"
    },
    "output_scale": {
      "type": "integer"
    },
    "carry_bits": {
      "type": "integer",
      "minimum": 0
    },
    "absolute_tolerance": {
      "type": "string",
      "pattern": "^[0-9]+/[1-9][0-9]*$",
      "description": "Nonnegative exact rational tolerance for automatic raw, scaled, or family analysis. The analyzer frontend also accepts exact decimals."
    },
    "a_bound": {
      "type": "string",
      "pattern": "^[0-9]+/[1-9][0-9]*$",
      "description": "Uniform absolute magnitude cap for every finite encoded matrix entry in a raw GEMM family. The analyzer frontend also accepts exact decimal strings."
    },
    "b_bound": {
      "type": "string",
      "pattern": "^[0-9]+/[1-9][0-9]*$",
      "description": "Uniform absolute magnitude cap for every finite encoded matrix entry in a raw GEMM family. The analyzer frontend also accepts exact decimal strings."
    },
    "c_bound": {
      "type": "string",
      "pattern": "^[0-9]+/[1-9][0-9]*$",
      "description": "Uniform absolute magnitude cap for every finite encoded matrix entry in a raw GEMM family. The analyzer frontend also accepts exact decimal strings."
    },
    "precision": {
      "enum": [
        "bf16",
        "tf32"
      ],
      "description": "Native encoded inputs: BF16 16-bit words or packed TF32 19-bit words, not FP32 register words."
    },
    "a_bounds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+/[1-9][0-9]*$"
      }
    },
    "b_bounds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+/[1-9][0-9]*$"
      }
    },
    "c_bounds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+/[1-9][0-9]*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "raw",
              "certify",
              "analyze"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "b": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "scaled",
              "certify_scaled",
              "analyze_scaled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "input_format",
          "output_format",
          "input_mode",
          "multiply_mode",
          "add_mode",
          "output_mode",
          "alpha",
          "beta"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "certify",
              "certify_scaled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "accumulator_scale",
          "product_scale",
          "carry_bits",
          "initial_bound"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "certify_scaled"
          }
        }
      },
      "then": {
        "required": [
          "alpha_scale",
          "beta_scale",
          "sum_scale",
          "output_scale"
        ]
      }
    },
    {
      "if": {
        "required": [
          "input_format"
        ],
        "properties": {
          "operation": {
            "enum": [
              "scaled",
              "certify_scaled",
              "analyze_scaled"
            ]
          },
          "input_format": {
            "const": "fp16"
          }
        }
      },
      "then": {
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "b": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "input_format"
        ],
        "properties": {
          "operation": {
            "enum": [
              "scaled",
              "certify_scaled",
              "analyze_scaled"
            ]
          },
          "input_format": {
            "const": "bf16"
          }
        }
      },
      "then": {
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "b": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "input_format"
        ],
        "properties": {
          "operation": {
            "enum": [
              "scaled",
              "certify_scaled",
              "analyze_scaled"
            ]
          },
          "input_format": {
            "const": "fp32"
          }
        }
      },
      "then": {
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "b": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "input_format"
        ],
        "properties": {
          "operation": {
            "enum": [
              "scaled",
              "certify_scaled",
              "analyze_scaled"
            ]
          },
          "input_format": {
            "const": "fp64"
          }
        }
      },
      "then": {
        "properties": {
          "a": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          },
          "b": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "analyze",
              "analyze_scaled",
              "analyze_family",
              "analyze_native",
              "analyze_entry_family"
            ]
          }
        }
      },
      "then": {
        "required": [
          "absolute_tolerance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "analyze_family"
          }
        }
      },
      "then": {
        "required": [
          "a_bound",
          "b_bound",
          "c_bound"
        ]
      },
      "else": {
        "if": {
          "properties": {
            "operation": {
              "const": "analyze_entry_family"
            }
          }
        },
        "then": {
          "required": [
            "a_bounds",
            "b_bounds",
            "c_bounds"
          ]
        },
        "else": {
          "required": [
            "a",
            "b",
            "c"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "native",
              "analyze_native"
            ]
          }
        }
      },
      "then": {
        "required": [
          "precision"
        ],
        "properties": {
          "model": {
            "enum": [
              "ampere",
              "hopper",
              "hopper_mma"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "precision"
              ],
              "properties": {
                "precision": {
                  "const": "bf16"
                }
              }
            },
            "then": {
              "properties": {
                "a": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "b": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "model": {
                  "enum": [
                    "ampere",
                    "hopper"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "precision"
              ],
              "properties": {
                "precision": {
                  "const": "tf32"
                }
              }
            },
            "then": {
              "properties": {
                "a": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 524287
                  }
                },
                "b": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 524287
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "model": {
            "enum": [
              "v100",
              "ampere",
              "hopper"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
