{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IEEE binary scalar request",
  "type": "object",
  "required": ["operation", "format", "mode", "a"],
  "properties": {
    "operation": {"enum": ["convert", "add", "sub", "mul", "fma"]},
    "format": {"enum": ["fp16", "fp32", "fp64"]},
    "target": {"enum": ["fp16", "fp32", "fp64"]},
    "mode": {"enum": ["rne", "rtz", "rdn", "rup"]},
    "tininess": {"enum": ["before", "after"], "default": "after"},
    "a": {"type": "integer", "minimum": 0},
    "b": {"type": "integer", "minimum": 0},
    "c": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "convert"}}}, "then": {"required": ["target"]}},
    {"if": {"properties": {"operation": {"enum": ["add", "sub", "mul", "fma"]}}}, "then": {"required": ["b"]}},
    {"if": {"properties": {"operation": {"const": "fma"}}}, "then": {"required": ["c"]}},
    {"if": {"properties": {"format": {"const": "fp16"}}}, "then": {"properties": {"a": {"maximum": 65535}, "b": {"maximum": 65535}, "c": {"maximum": 65535}}}},
    {"if": {"properties": {"format": {"const": "fp32"}}}, "then": {"properties": {"a": {"maximum": 4294967295}, "b": {"maximum": 4294967295}, "c": {"maximum": 4294967295}}}},
    {"if": {"properties": {"format": {"const": "fp64"}}}, "then": {"properties": {"a": {"maximum": 18446744073709551615}, "b": {"maximum": 18446744073709551615}, "c": {"maximum": 18446744073709551615}}}}
  ]
}
